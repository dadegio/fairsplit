+    queryFn: () => api<PersonalOverview>(`/personal/overview?month=${month}`)
+  });
+  const data = overview.data;
+
+  useEffect(() => {
+    if (!data) return;
+    setIncomeInput(data.plan ? formatMoneyInput(data.plan.income) : '');
